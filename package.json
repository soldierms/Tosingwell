{
  "name": "tosingwell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read, convert, play and print choral scores in Tonic Sol-fa and Staff notation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
