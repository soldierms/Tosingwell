# Copy this file to ".env" (in the same folder) and paste your key after the "=".
# .env is listed in .gitignore, so it is never committed or pushed.
# You only need ONE of the two keys below.

# Option 1 — Google Gemini (has a free tier; get a key at https://aistudio.google.com/apikey).
# Note: Google says content sent on the free tier is used to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Option 2 — Anthropic Claude (paid; https://console.anthropic.com).
ANTHROPIC_API_KEY=
# READ_MODEL=claude-sonnet-5-5

# If both keys are set, Gemini is used unless you choose:
# READ_PROVIDER=claude
